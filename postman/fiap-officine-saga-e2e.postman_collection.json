{
  "info": {
    "name": "fiap-officine — Saga E2E (Fase 4)",
    "description": "Fluxo completo da saga entre os-service, billing-service e execution-service. Execute as pastas em ordem (Runner com delay de 2000 ms entre requisições, pois a saga é assíncrona). Local: docker compose do fiap-officine-e2e. AWS: aponte as três URLs para o API Gateway.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "os_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "billing_url",
      "value": "http://localhost:8001"
    },
    {
      "key": "execution_url",
      "value": "http://localhost:8002"
    },
    {
      "key": "api_gateway",
      "value": "https://<api-id>.execute-api.sa-east-1.amazonaws.com"
    }
  ],
  "item": [
    {
      "name": "0. Preparação",
      "item": [
        {
          "name": "Registrar operador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{os_url}}/api/v1/auth/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"operador\",\n  \"email\": \"operador@oficina.com\",\n  \"nome_completo\": \"Operador\",\n  \"password\": \"senha12345\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201, 400\", () => pm.expect(pm.response.code).to.be.oneOf([201, 400]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login operador (JWT admin)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{os_url}}/api/v1/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "operador"
                },
                {
                  "key": "password",
                  "value": "senha12345"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "pm.collectionVariables.set(\"token\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{os_url}}/api/v1/clientes/",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Maria Demo\",\n  \"cpf_cnpj\": \"529.982.247-25\",\n  \"email\": \"maria@demo.com\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.expect(pm.response.code).to.be.oneOf([201]));",
                  "pm.collectionVariables.set(\"cliente_id\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login do cliente por CPF (JWT cliente)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{os_url}}/api/v1/auth/cliente",
