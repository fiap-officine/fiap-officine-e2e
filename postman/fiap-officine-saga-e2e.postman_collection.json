                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Pastilha de freio\",\n  \"preco\": 80.0\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.expect(pm.response.code).to.be.oneOf([201]));",
                  "pm.collectionVariables.set(\"peca_id\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Entrada de estoque (Execution)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
